# Public site URL (used for canonical URLs, sitemap, Open Graph, structured data).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery. Any HTTPS endpoint that accepts a JSON POST
# (email service, CRM, Zapier/Make, your own backend...). Leave unset and the form will
# honestly report that it could not send and offer a WhatsApp fallback instead.
CONTACT_WEBHOOK_URL=
